{
  "command": "start",
  "port": 9000,
  "timeoutMs": 60000,
  "idleTimeoutMs": 10000,
  "maxConnections": 16,
  "maxMessages": 256,
  "commands": [
    {
      "regex": "^SHUTDOWN$",
      "action": "shutdown",
      "response": "bye"
    }
  ],
  "rules": [
    {
      "regex": "^13PC 01 001 1$",
      "response": "13PC 01 001 1 Load Arm 1"
    },
    {
      "regex": "^13PC 01 002 BLEND01$",
      "response": "13PC 01 002 BLEND01 Recipe Name"
    },
    {
      "regex": "^13PC 01 003 0$",
      "response": "13PC 01 003 0 HM Classification"
    },
    {
      "regex": "^13PC 01 090 1$",
      "response": "13PC 01 090 1 Sequential Delivery"
    },
    {
      "regex": "^13PC 01 004 1$",
      "response": "13PC 01 004 1 Position 1 Product"
    },
    {
      "regex": "^13PC 01 005 060\\.0$",
      "response": "13PC 01 005 060.0 Position 1 Percentage"
    },
    {
      "regex": "^13PC 01 006 2$",
      "response": "13PC 01 006 2 Position 2 Product"
    },
    {
      "regex": "^13PC 01 007 025\\.0$",
