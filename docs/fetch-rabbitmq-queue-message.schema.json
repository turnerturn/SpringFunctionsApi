{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:functions-api:fetchRabbitMqQueueMessage:request",
  "title": "fetchRabbitMqQueueMessage request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "username",
    "passwordEnv",
    "queue",
    "settlement"
  ],
  "properties": {
    "host": {
      "type": "string",
      "pattern": "^(?:localhost|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|0?[0-9]{1,2})(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|0?[0-9]{1,2})){3})$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "virtualHost": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "username": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "passwordEnv": {
      "const": "RABBITMQ_PASSWORD"
    },
    "queue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "settlement": {
      "enum": [
        "acknowledge",
        "requeue"
      ]
    },
    "pollTimeoutMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30000,
      "default": 0
    },
    "tls": {
      "type": "boolean",
      "default": false
    }
  }
}
